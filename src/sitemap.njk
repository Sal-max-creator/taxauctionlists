---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and p.url != "/404.html" and not p.url.endsWith(".xml") and not (p.data.c and p.data.c.page and not p.data.c.page.indexable) %}
  <url><loc>{{ p.url | absUrl(site.url) }}</loc><lastmod>{% if p.data.c and p.data.c.lastChecked %}{{ [p.data.c.lastChecked, site.pagesUpdated] | sort | last }}{% else %}{{ build.date }}{% endif %}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
