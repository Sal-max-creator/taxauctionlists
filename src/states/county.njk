---
layout: base.njk
pagination:
  data: counties
  size: 1
  addAllPagesToCollections: true
  alias: c
permalink: "{{ c.url }}"
eleventyComputed:
  title: "{{ c.fullName }}, {{ c.state.state }} tax sale{% if c.upcoming.length and not c.link_only %}: {{ c.upcoming[0].date | shortDate }}{% else %} dates and how to bid{% endif %}"
  description: "{{ c.page.description }}"
---
{%- set crumbs = [{ name: "States", url: "/states/" }, { name: c.state.name, url: c.state.url }, { name: c.county, url: c.url }] %}
{% include "breadcrumbs.njk" %}
<h1>{{ c.fullName }}, {{ c.state.name }} tax sale</h1>
<p class="muted">Last checked {{ c.lastChecked | longDate }}</p>
<p class="lede">{{ c.page.intro }}</p>
{% include "notice.njk" %}

{% if c.link_only %}
<h2>Sale dates and details</h2>
<p>This office's website doesn't allow its content to be reused commercially, so we don't copy its sale details here. <a href="{{ c.sources[0].url }}" rel="nofollow noopener">See the county's tax sale page</a> for dates, registration and terms.</p>
{% else %}
<h2>When is the next {{ c.fullName }} tax sale?</h2>
{% if c.upcoming.length %}
  {% for s in c.upcoming %}
  <dl class="facts">
    <dt>Date</dt><dd><strong>{{ s.date | longDate }}</strong>{% if s.end_date %} to <strong>{{ s.end_date | longDate }}</strong>{% endif %}{% if s.time and s.time != "not stated" %}, {{ s.time }}{% endif %}</dd>
    <dt>Sale</dt><dd>{{ s.label }}</dd>
    {% if s.deposit %}<dt>Deposit</dt><dd>{{ s.deposit }}</dd>{% endif %}
    {% if s.registration_deadline %}<dt>Register by</dt><dd>{{ s.registration_deadline }}</dd>{% endif %}
    <dt>Source</dt><dd><a href="{{ s.source_url }}" rel="nofollow noopener">{{ s.source_url }}</a></dd>
  </dl>
  <p></p>
  {% endfor %}
{% else %}
  <p class="empty">{{ c.next_sale_note or "The county hasn't posted its next sale date yet." }}</p>
{% endif %}
{% if c.schedule_rule %}<p>The county's stated schedule:</p>
<blockquote class="evidence">{{ c.schedule_rule }}</blockquote>{% endif %}

<h2>How to bid at the {{ c.fullName }} tax sale</h2>
<dl class="facts">
  <dt>Sale type</dt><dd><span class="tag tag-{{ c.sale_type | replace(' ', '-') }}">{{ c.sale_type }}</span></dd>
  <dt>Format</dt><dd>{{ c.format | capitalize }}</dd>
  {% if c.platform and c.platform.name %}<dt>Auction site</dt><dd>{% if c.platform.url %}<a href="{{ c.platform.url }}" rel="nofollow noopener">{{ c.platform.name }}</a>{% else %}{{ c.platform.name }}{% endif %} <span class="muted">(we link to it; we don't copy its listings)</span></dd>{% endif %}
</dl>
{% if c.how_to_bid %}<p>{{ c.how_to_bid }}</p>{% endif %}
{% for n in c.page.extraNotes %}<p class="muted">{{ n }}</p>{% endfor %}

{% if c.page.quotes.length %}
<h2>What {{ c.fullName }}'s pages say</h2>
<p>Quoted word for word from the county's own pages, with where each line came from.</p>
{% for q in c.page.quotes %}
<blockquote class="evidence">“{{ q.quote }}” <span class="muted">(<a href="{{ q.url }}" rel="nofollow noopener">{{ q.host }}</a>)</span></blockquote>
{% endfor %}
{% endif %}

{% if c.page.pastSales.length %}
<h2>Past {{ c.fullName }} sales on record</h2>
<ul>
{% for s in c.page.pastSales %}
  <li><strong>{{ s.date | longDate }}</strong>{% if s.end_date %} to {{ s.end_date | longDate }}{% endif %}{% if s.label %}: {{ s.label }}{% endif %}{% if s.deposit %}. Deposit: {{ s.deposit }}{% endif %} <span class="muted">(<a href="{{ s.source_url }}" rel="nofollow noopener">{{ s.source_url | hostname }}</a>)</span></li>
{% endfor %}
</ul>
{% endif %}
{% endif %}

<h2>How {{ c.state.name }} tax sales work</h2>
<p>{{ c.page.stateFirst }} <a href="{{ c.state.url }}">More on {{ c.state.name }} tax sales →</a></p>

<h2>County contact</h2>
<dl class="facts">
  <dt>Office</dt><dd>{{ c.office }}</dd>
  {% if c.phone %}<dt>Phone</dt><dd>{{ c.phone }}</dd>{% endif %}
  {% if c.address %}<dt>Address</dt><dd>{{ c.address }}</dd>{% endif %}
  {% if c.website %}<dt>Website</dt><dd><a href="{{ c.website }}" rel="nofollow noopener">{{ c.website }}</a></dd>{% endif %}
</dl>

<h2>Sources</h2>
<ul>
{% for s in c.sources %}
  <li><a href="{{ s.url }}" rel="nofollow noopener">{{ s.url }}</a> <span class="muted">checked {{ s.read_on | shortDate }}</span></li>
{% endfor %}
</ul>
<p class="muted">Source: {{ c.fullName }}, {{ c.state.name }} official websites listed above. {{ site.name }} is independent and is not affiliated with or endorsed by {{ c.fullName }}.</p>

<h2>More {{ c.state.name }} tax sales</h2>
<ul class="inline-list">
{% for o in c.state.counties %}{% if o.slug != c.slug %}
  <li><a href="{{ o.url }}">{{ o.county }}</a>{% if o.upcoming.length and not o.link_only %} <span class="muted">{{ o.upcoming[0].date | shortDate }}</span>{% endif %}</li>
{% endif %}{% endfor %}
</ul>
<p><a href="{{ c.state.url }}">← All {{ c.state.name }} tax sales</a></p>
{% include "paid-teaser.njk" %}
{% include "signup.njk" %}
