// Cloudflare Workers Builds config: serves the Eleventy output in _site as static assets.
// The Worker name must match the Cloudflare project name.
{
  "name": "taxauctionlists",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
